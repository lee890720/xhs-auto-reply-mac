# 小红书自动回复工作流 - 环境配置模板
# 复制此文件为 .env 并填入你的实际配置

# ============ Coze API（必需） ============
# 1. 在 coze.cn 创建 Bot，设定好人设和回复规则
# 2. 进入 Bot → 发布 → API
# 3. 获取 Bot ID 和 Personal Access Token
COZE_API_TOKEN=pat_xxxxxxxxxxxxx
COZE_BOT_ID=xxxxxxxxxxxxxxxxxxxx

# ============ 浏览器（默认值即可） ============
CDP_PORT=9222

# ============ 回复策略 ============
# auto = 全自动发送（慎用）  review = 生成草稿待审核
REPLY_MODE=review
# 轮询间隔（秒）
POLL_INTERVAL=60
# 每日最大回复数
DAILY_REPLY_LIMIT=50

# ============ 账号角色（可选，覆盖默认值） ============
# ACCOUNT_PERSONA="你是一个美食博主..."
